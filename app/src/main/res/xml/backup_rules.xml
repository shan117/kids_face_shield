<?xml version="1.0" encoding="utf-8"?>
<!--
    Defense-in-depth: even if allowBackup is ever flipped back to true, biometric and
    lock-state files MUST NOT be backed up. The face embedding is a biometric template
    and must stay device-local for the lifetime of the install only.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/app_lock_settings.preferences_pb" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
