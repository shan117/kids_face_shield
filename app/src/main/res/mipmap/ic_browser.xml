        android:pathData="M12,30 Q12,12 30,12 L78,12 Q96,12 96,30 L96,78 Q96,96 78,96 L30,96 Q12,96 12,78 Z"
        android:fillColor="#FFF7EC" />

    <path
        android:pathData="M32,54 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0"
        android:strokeColor="#006072"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M32,54 L76,54"
        android:strokeColor="#006072"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,32 a12,22 0 1,0 0,44 a12,22 0 1,0 0,-44"
        android:strokeColor="#006072"
