rules_version = '2';

// ============================================================================================
//  STAGED — publish only after PHASE7_AUTH_PLAN.md §3 steps 1-3 are done and verified.
//
//  Publishing before an authenticating build is on BOTH devices locks everything out: no request
//  would carry request.auth, so nothing could be read or written.
//
//  Order:
//    1. Enable Authentication → Sign-in method → Anonymous
//    2. Delete dev documents in reports/ commands/ locations/ grants/ pairings/
//    3. Install on both devices, re-pair, and CHECK pairings/{id} has TWO uids
//    4. Then replace firestore.rules with this file and publish
// ============================================================================================
//
//  Membership lives in ONE record per pairing — pairings/{pairingId} — and every relay collection
//  consults it.
//
//  Why not per-document membership: each collection has exactly one writer and one reader
//  (child writes reports+locations, parent reads them; parent writes commands+grants, child reads
//  them). Stamping the creator's uid on each document therefore left the reader out of its own
//  document's uids, and a reader cannot add itself — claiming is a write. That model denied all four
//  directions at once. grants/ made it undeniable: that document may be created weeks after pairing,
//  long after any per-document claim window could close.
//
//  Membership is established once, at pairing, when both devices are demonstrably present.
//
//  The payload stays end-to-end encrypted regardless; the relay never holds a key. What these rules
//  add is that the pairing id alone stops being a bearer token — it remains unguessable and
//  unlistable, but on its own it no longer grants read, write or delete.

service cloud.firestore {
  match /databases/{database}/documents {

    function membership(pairingId) {
      return get(/databases/$(database)/documents/pairings/$(pairingId)).data;
    }

    function isMember(pairingId) {
      return request.auth != null
          && exists(/databases/$(database)/documents/pairings/$(pairingId))
          && membership(pairingId).uids is list
          && request.auth.uid in membership(pairingId).uids;
    }

    // The pairing's membership record itself.
    //
    // create: the child stamps itself as the first member.
    // update: either an existing member (refreshing the claim window), or a second device claiming a
    //         free slot before the deadline. hasAll(old) forbids removing anyone; hasOnly(old + me)
    //         forbids adding a third party. Once two uids are recorded the claim branch is shut
    //         permanently, so a QR photographed afterwards is worthless.
    match /pairings/{pairingId} {
      allow create: if request.auth != null
                    && request.resource.data.uids == [request.auth.uid]
                    && request.resource.data.claimDeadline is int;

      allow update: if request.auth != null
                    && request.resource.data.uids.hasAll(resource.data.uids)
                    && request.resource.data.uids
                         .hasOnly(resource.data.uids.concat([request.auth.uid]))
                    && (
                         request.auth.uid in resource.data.uids
                         || (
                              resource.data.uids.size() < 2
                              && request.time.toMillis() < resource.data.claimDeadline
                            )
                       );

      allow get: if request.auth != null;
      allow delete: if isMember(pairingId);
      allow list: if false;
    }

    // Child uploads the encrypted screen-time report; parent reads it.
    match /reports/{pairingId} {
      allow get, create, update, delete: if isMember(pairingId);
      allow list: if false;
    }

    // Parent writes an encrypted command; child reads it. Decryption remains the real authorization
    // for ACTING on a command — this only decides who may place one.
    match /commands/{pairingId} {
      allow get, create, update, delete: if isMember(pairingId);
      allow list: if false;
    }

    // Child's location log. The most sensitive collection, and the one where delete matters most: a
    // log must never outlive the pairing that authorised it.
    match /locations/{pairingId} {
      allow get, create, update, delete: if isMember(pairingId);
      allow list: if false;
    }

    // Entitlement grants: parent writes "this child is covered until <date>", child reads it.
    match /grants/{pairingId} {
      allow get, create, update, delete: if isMember(pairingId);
      allow list: if false;
    }

    // The only CHILD → PARENT channel: the child asking for more screen time. Encrypted under the
    // pairing key for authenticity — otherwise anyone holding a pairing id could spam a parent with
    // fake requests from their child. See UX_IMPROVEMENT_PLAN.md §1.
    match /requests/{pairingId} {
      allow get, create, update, delete: if isMember(pairingId);
      allow list: if false;
    }
  }
}
