<?xml version="1.0" encoding="utf-8"?>
<!--
  Background for the Kids Shield Browser icon.

  Deliberately the INVERSE of the app icon: the app is a warm mark on a teal gradient, so the browser
  is a teal mark on the app's cream. Reusing the brand's own cream (#FFF7EC, already in the app icon's
  foreground) keeps the two obviously a set while making them separable at a glance — the first
  version put a globe on the same teal gradient, and two teal squircles side by side in the drawer are
  near-indistinguishable at icon size.

  Full-bleed 108x108 with no corners of its own: the launcher applies its own mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FFFFF7EC" />
                <item android:offset="1" android:color="#FFFFE2C4" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
