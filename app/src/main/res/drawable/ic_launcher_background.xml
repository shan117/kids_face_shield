<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed brand-teal gradient. The launcher applies its own mask (circle / squircle /
     rounded-square), so this layer must fill the whole 108x108 with no corners of its own. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FF15A2BA" />
                <item android:offset="1" android:color="#FF006072" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
