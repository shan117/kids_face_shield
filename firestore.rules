rules_version = '2';

// Parent Remote Report relay. Every document under reports/{pairingId} holds ONLY ciphertext
// (an AES-GCM iv + ciphertext blob the relay cannot read) — see PARENT_REMOTE_REPORT_PLAN.md §2.
//
// Interim access model (§8): the 128-bit `pairingId` is a secret bearer token. You can read/write a
// report only if you already know its id; listing the collection is denied so ids can't be enumerated,
// and the payload is E2E-encrypted regardless. Production hardening = per-device Anonymous-Auth uids
// recorded at pairing (Phase 7); swap the `if true` guards for `request.auth.uid in resource.data.uids`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /reports/{pairingId} {
      // Read/write a single known doc; ciphertext only (enforced E2E, not by rules).
      allow get, create, update: if true;
      // No enumeration. Delete allowed so unpair/revoke can wipe the cloud copy (you must know the id).
      allow delete: if true;
      allow list: if false;
    }

    // Parent Remote Control: parent writes an encrypted command, child reads/listens. Same bearer-token
    // model as reports — and crucially the command only *applies* if it decrypts under the pairing key
    // (decryption = authorization), so knowing the id alone can't forge an action. See PARENT_REMOTE_CONTROL_PLAN.md.
    match /commands/{pairingId} {
      allow get, create, update, delete: if true;
      allow list: if false;
    }

    // Child location log. Same bearer-token model again: one document per pairing holding the whole
    // capped log (a subcollection is impossible here — `list` is denied everywhere, by design).
    //
    // The relay stores coordinates it cannot read: the document is an AES-GCM iv + ciphertext pair
    // under the pairing key, which only the two paired devices hold. Knowing the id lets you fetch the
    // blob and nothing more. Delete is allowed so unpair / key-rotation / "clear history" can wipe the
    // cloud copy — location must never outlive the pairing that authorised it.
    // See LOCATION_FEATURE_PLAN.md §3.
    match /locations/{pairingId} {
      allow get, create, update, delete: if true;
      allow list: if false;
    }

    // Entitlement grants. The parent writes "this child is covered until <date>"; the child reads it.
    // Same bearer-token model, and encrypted under the pairing key for AUTHENTICITY rather than secrecy:
    // an expiry timestamp is not a secret, but a plaintext grant would let anyone who learned a pairing
    // id hand themselves free premium. See ENTITLEMENT_SHARING_PLAN.md.
    match /grants/{pairingId} {
      allow get, create, update, delete: if true;
      allow list: if false;
    }

    // Pairing membership: which two device uids a pairing belongs to. Written at pairing time and read
    // by the strict rules in firestore.rules.phase7, where it becomes the thing that stops the pairing
    // id working as a bearer token. Permissive here like everything else until that switchover.
    // See PHASE7_AUTH_PLAN.md.
    match /pairings/{pairingId} {
      allow get, create, update, delete: if true;
      allow list: if false;
    }

    // The only CHILD → PARENT channel: the child asking for more screen time. Encrypted under the
    // pairing key for authenticity — otherwise anyone holding a pairing id could spam a parent with
    // fake requests from their child. See UX_IMPROVEMENT_PLAN.md §1.
    match /requests/{pairingId} {
      allow get, create, update, delete: if true;
      allow list: if false;
    }
  }
}
