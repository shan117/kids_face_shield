# Release signing credentials. Copy this file to `keystore.properties` (which is gitignored) and
# fill in the real values. NEVER commit keystore.properties or the .jks file.
#
# 1. Create your upload keystore once (keep the .jks + passwords backed up safely — losing them
#    means you can't update the app):
#
#    keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2. Put upload-keystore.jks at the repo root, then set the values below.
#    storeFile is resolved relative to the app/ module, so a repo-root keystore is "../upload-keystore.jks".

storeFile=../upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
