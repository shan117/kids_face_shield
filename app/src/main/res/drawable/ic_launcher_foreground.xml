<?xml version="1.0" encoding="utf-8"?>
<!-- Lock-Buddy on camera (see design/logos/lock_buddy_cam.svg). Authored in the 512 space of
     the source SVG and wrapped in a 0.9 group scale so the viewfinder corners sit safely inside
     the launcher mask's safe zone. SVG circles/rects/ellipses are converted to path data because
     Android VectorDrawable supports <path> only. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.9"
        android:scaleY="0.9">

        <!-- camera viewfinder framing -->
        <path android:fillColor="#00000000" android:strokeColor="#FFF7EC" android:strokeWidth="16"
            android:strokeLineCap="round" android:strokeLineJoin="round"
            android:pathData="M150,200 L150,162 L188,162" />
        <path android:fillColor="#00000000" android:strokeColor="#FFF7EC" android:strokeWidth="16"
            android:strokeLineCap="round" android:strokeLineJoin="round"
            android:pathData="M324,162 L362,162 L362,200" />
        <path android:fillColor="#00000000" android:strokeColor="#FFF7EC" android:strokeWidth="16"
            android:strokeLineCap="round" android:strokeLineJoin="round"
            android:pathData="M150,348 L150,386 L188,386" />
        <path android:fillColor="#00000000" android:strokeColor="#FFF7EC" android:strokeWidth="16"
            android:strokeLineCap="round" android:strokeLineJoin="round"
            android:pathData="M324,386 L362,386 L362,348" />

        <!-- flash -->
        <path android:fillColor="#FFC24B"
            android:pathData="M300,128 L307,148 L327,155 L307,162 L300,182 L293,162 L273,155 L293,148 Z" />

        <!-- shackle -->
        <path android:fillColor="#00000000" android:strokeColor="#FFF7EC" android:strokeWidth="26"
            android:strokeLineCap="round"
            android:pathData="M214,250 L214,222 Q214,184 256,184 Q298,184 298,222 L298,250" />

        <!-- kid hair tuft -->
        <path android:fillColor="#00000000" android:strokeColor="#FFC24B" android:strokeWidth="13"
            android:strokeLineCap="round"
            android:pathData="M250,182 C246,158 285,156 279,179" />

        <!-- lock body -->
        <path android:fillColor="#FFF7EC"
            android:pathData="M230,250 L282,250 Q314,250 314,282 L314,344 Q314,376 282,376 L230,376 Q198,376 198,344 L198,282 Q198,250 230,250 Z" />

        <!-- eyes -->
        <path android:fillColor="#06414E" android:pathData="M220,300 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0 Z" />
        <path android:fillColor="#06414E" android:pathData="M264,300 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0 Z" />
        <path android:fillColor="#FFFFFF" android:pathData="M224,295 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
        <path android:fillColor="#FFFFFF" android:pathData="M268,295 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />

        <!-- cheek blush -->
        <path android:fillColor="#FF9E7A" android:fillAlpha="0.85" android:pathData="M195,322 a15,10 0 1,0 30,0 a15,10 0 1,0 -30,0 Z" />
        <path android:fillColor="#FF9E7A" android:fillAlpha="0.85" android:pathData="M287,322 a15,10 0 1,0 30,0 a15,10 0 1,0 -30,0 Z" />

        <!-- smile + tongue -->
        <path android:fillColor="#06414E" android:pathData="M228,330 Q256,366 284,330 Q256,348 228,330 Z" />
        <path android:fillColor="#FF9E7A" android:pathData="M246,344 a10,6 0 1,0 20,0 a10,6 0 1,0 -20,0 Z" />
    </group>
</vector>
