<?xml version="1.0" encoding="utf-8"?>
<!--
    Defense-in-depth: biometric template + lock-state must never leave the device,
    whether by cloud backup or D2D transfer. See backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/app_lock_settings.preferences_pb" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/app_lock_settings.preferences_pb" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
